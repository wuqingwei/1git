+#[cfg(target_os = "macos")]
+#[cfg(not(all(target_arch = "wasm32", target_os = "unknown")))]
+#[napi]
+impl GpuixRenderer {
+    /// Synchronous native veto; set before starting a protected operation.
+    #[cfg(target_os = "macos")]
+    #[napi]
+    pub fn set_close_blocked(&self, blocked: bool) {
+        self.close_protection.0.lock().unwrap().0 = blocked;
+    }
+
+    /// Consume a blocked close/quit attempt without queuing a later quit.
+    #[cfg(target_os = "macos")]
+    #[napi]
+    pub fn take_close_requested(&self) -> bool {
+        std::mem::take(&mut self.close_protection.0.lock().unwrap().1)
+    }
+
+    /// Return a bounded AppKit PNG without launching the application.
+    #[cfg(target_os = "macos")]
+    #[napi]
+    pub fn get_application_icon(&self, path: String) -> Result<Option<Buffer>> {
+        gpui_macos::application_icon_png(&path)
+            .map(|image| image.map(Buffer::from))
+            .map_err(|error| Error::from_reason(error.to_string()))
+    }
+
+    /// Installed CoreText families, without opening a system font panel.
+    #[cfg(target_os = "macos")]
+    #[napi]
+    pub fn get_font_families(&self) -> Vec<String> {
+        crate::installed_font_families()
+    }
+
+    /// Read the OS preference, unaffected by an explicit per-window appearance.
+    #[cfg(target_os = "macos")]
+    #[napi]
+    pub fn get_system_appearance(&self) -> String {
+        match gpui_macos::system_appearance() {
+            gpui::WindowAppearance::Dark | gpui::WindowAppearance::VibrantDark => "dark",
+            _ => "light",
+        }.to_string()
+    }
+
+    /// Match this window's AppKit material and menus to its explicit app theme.
+    #[cfg(target_os = "macos")]
+    #[napi]
+    pub fn set_window_appearance(&self, appearance: String) -> Result<()> {
+        let dark = match appearance.as_str() {
+            "light" => false,
+            "dark" => true,
+            _ => return Err(Error::from_reason("Window appearance must be light or dark")),
+        };
+        update_window_without_view(|window, _cx| -> Result<()> {
+            gpui_macos::set_window_appearance(window, dark)
+                .map_err(|error| Error::from_reason(error.to_string()))?;
+            window.refresh();
+            Ok(())
+        })?
+    }
+}
